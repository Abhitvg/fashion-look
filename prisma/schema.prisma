generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Appointment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  location  String
  service   String
  date      String
  time      String
  
  name      String
  email     String
  phone     String
  whatsapp  String?
  notes     String?
  
  status    String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED
}
